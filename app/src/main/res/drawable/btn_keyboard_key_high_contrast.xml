<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checkable="true" android:state_checked="true"
        android:drawable="@drawable/btn_keyboard_key_pressed_high_contrast" />
    <item android:state_empty="true" android:state_pressed="true"
        android:drawable="@color/key_pressed_high_contrast" />
    <item android:state_empty="true"
        android:drawable="@android:color/transparent" />
    <item android:state_pressed="true"
        android:drawable="@drawable/btn_keyboard_key_pressed_high_contrast" />
    <item android:drawable="@drawable/btn_keyboard_key_normal_high_contrast" />
</selector>
