<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:id="@+id/suggestions_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false" />
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:id="@+id/important_notice_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false" >
        <TextView
            android:id="@+id/important_notice_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6sp"
            android:textSize="16sp"
            style="?attr/suggestionWordStyle" />
    </LinearLayout>
    <org.prauga.keyboard.suggestions.InlineSuggestionsStrip
        android:id="@+id/inline_suggestions_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:visibility="invisible" />
    <LinearLayout
        android:id="@+id/clipboard_suggestion_strip"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:visibility="invisible" />
    <org.prauga.keyboard.toolbar.KeyboardToolbar
        android:id="@+id/keyboard_toolbar"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:visibility="invisible" />
    <ImageButton
        android:id="@+id/suggestions_strip_toolbar_key"
        android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
        android:layout_height="fill_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:scaleType="center"
        android:src="@drawable/ic_toolbar_toggle"
        android:contentDescription="@string/show_toolbar_key"
        style="?attr/suggestionWordStyle" />
    <ImageButton
        android:id="@+id/suggestions_strip_float_key"
        android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
        android:layout_height="fill_parent"
        android:layout_toEndOf="@id/suggestions_strip_toolbar_key"
        android:layout_toRightOf="@id/suggestions_strip_toolbar_key"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_floating_keyboard"
        android:contentDescription="@string/spoken_description_float_keyboard"
        style="?attr/suggestionWordStyle" />
    <ImageButton
        android:id="@+id/suggestions_strip_split_key"
        android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
        android:layout_height="fill_parent"
        android:layout_toEndOf="@id/suggestions_strip_float_key"
        android:layout_toRightOf="@id/suggestions_strip_float_key"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_split_keyboard"
        android:visibility="gone"
        android:contentDescription="@string/spoken_description_split_keyboard"
        style="?attr/suggestionWordStyle" />
    <ImageButton
        android:id="@+id/suggestions_strip_voice_key"
        android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
        android:layout_height="fill_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/spoken_description_mic"
        style="?attr/suggestionWordStyle" />
    <org.prauga.keyboard.textfield.StripTextField
        android:id="@+id/strip_text_field"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="invisible">
        <ImageButton
            android:id="@+id/strip_text_field_close"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/strip_text_field_close"
            style="?attr/suggestionWordStyle" />
        <TextView
            android:id="@+id/strip_text_field_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxWidth="@dimen/emoji_search_query_max_width"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="start"
            android:textSize="@dimen/clipboard_history_title_size" />
        <HorizontalScrollView
            android:id="@+id/strip_text_field_scroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/emoji_search_result_padding"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/strip_text_field_results"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />
        </HorizontalScrollView>
    </org.prauga.keyboard.textfield.StripTextField>
</merge>
